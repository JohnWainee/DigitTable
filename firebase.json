{
  "functions": {
    "source": "apps/functions",
    "codebase": "digitable",
    "runtime": "nodejs22",
    "predeploy": ["npm run build --workspace @digitable/functions"]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
