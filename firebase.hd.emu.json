{
 "functions": {
  "source": "apps/functions",
  "codebase": "digitable",
  "runtime": "nodejs22",
  "predeploy": [
   "npm run build --workspace @digitable/functions"
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 },
 "database": {
  "rules": "database.rules.json"
 },
 "emulators": {
  "auth": {
   "port": 61099
  },
  "firestore": {
   "port": 61080
  },
  "database": {
   "port": 61000
  },
  "functions": {
   "port": 61001
  },
  "ui": {
   "enabled": false
  },
  "singleProjectMode": true,
  "hub": {
   "port": 61400
  },
  "logging": {
   "port": 61500
  }
 }
}