rules_version = '2';

// PLACEHOLDER — Phase 2 PR 1 (repository interface + emulator harness) only.
// This default-deny rule set exists solely so the Firestore emulator can boot
// for this PR's connectivity smoke test (docs/PHASE_2_PLAN.md, PR 1). It is
// not the room data model's real security rule set — that is Phase 2 PR 2
// ("Firestore data model and rules"), which implements the uidBindings-based
// membership/own-projection/gm/table checks from docs/ARCHITECTURE.md
// section 8/11. The smoke test in packages/testing/test-emulator exercises
// this default-deny behavior directly, then separately proves a read/write
// round-trip using @firebase/rules-unit-testing's rules-disabled test
// context (a supported, testing-only escape hatch), never by relaxing this
// rule set to "allow all".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
