rules_version = '2';

// Phase 2 PR 2: clients have a read-only, viewer-scoped Firestore surface.
// The uidBindings reverse index is deliberately service-only: rules use its
// existence and fields but never expose it, bindings, authority, snapshots,
// or room-code indices to clients. All accepted-command writes arrive later
// through the trusted Function (PR 4).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function binding(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)/uidBindings/$(request.auth.uid));
    }

    function isMember(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/uidBindings/$(request.auth.uid));
    }

    function isOwnMember(roomId, memberId) {
      return isMember(roomId) && binding(roomId).data.memberId == memberId;
    }

    function hasCapability(roomId, capability) {
      return isMember(roomId) && binding(roomId).data.capability == capability;
    }

    // `gm` and `table` are reserved viewer IDs (packages/contracts RESERVED_VIEWER_IDS),
    // never member IDs. Excluding them from the own-member branch means a
    // mis-minted binding whose memberId collides with a reserved ID cannot
    // read a reserved projection without the matching capability.
    function isReservedViewer(viewerId) {
      return viewerId == "gm" || viewerId == "table";
    }

    match /rooms/{roomId} {
      allow read, write: if false;

      match /meta/current {
        allow read: if isMember(roomId);
        allow write: if false;
      }
      match /authority/current { allow read, write: if false; }
      match /members/{memberId} {
        allow read: if isMember(roomId);
        allow write: if false;
      }
      match /bindings/{memberId} { allow read, write: if false; }
      match /uidBindings/{uid} { allow read, write: if false; }
      // Phase 2 PR 3: room passphrase hash, the separate table-code hash, and
      // per-seat recovery-code hashes. Only the trusted admission authority
      // (apps/functions) reads or writes any of these paths.
      match /admission/secret { allow read, write: if false; }
      match /admission/tableSecret { allow read, write: if false; }
      match /recovery/{memberId} { allow read, write: if false; }
      match /projections/{viewerId} {
        allow read: if (!isReservedViewer(viewerId) && isOwnMember(roomId, viewerId))
          || (viewerId == "gm" && hasCapability(roomId, "gm"))
          || (viewerId == "table" && hasCapability(roomId, "table"));
        allow write: if false;
      }
      match /receipts/{receiptId} {
        allow read: if isOwnMember(roomId, resource.data.memberId);
        allow write: if false;
      }
      match /snapshots/{sequence} { allow read, write: if false; }
      match /events/shared/items/{sequence} {
        allow read: if isMember(roomId);
        allow write: if false;
      }
      match /events/gm/items/{sequence} {
        allow read: if hasCapability(roomId, "gm");
        allow write: if false;
      }
      match /events/{partition}/items/{sequence} {
        allow read: if isMember(roomId)
          && partition == "member-" + binding(roomId).data.memberId;
        allow write: if false;
      }
      // Board task A06: GM-visible audit trail (docs/ARCHITECTURE.md section 8's
      // "Redemption" flow, "a GM-visible audit event naming only the seat").
      // Written only by the trusted recoverSeat transaction.
      match /audit/{auditId} {
        allow read: if hasCapability(roomId, "gm");
        allow write: if false;
      }
    }

    match /roomCodes/{code} { allow read, write: if false; }
    // Phase 2 PR 3: admission throttle counters (per code+IP, per IP, per
    // UID; document IDs are hashes), kept outside rooms/ so guesses at codes
    // that resolve to no room are bounded too. Service-only for the whole
    // tree; a client that could read or reset them could defeat the throttle.
    match /admissionThrottle/{document=**} { allow read, write: if false; }
    // Board task A03: createRoom's idempotency receipt (keyed by the
    // client-chosen requestId, never a secret itself, but it names a real
    // roomId/roomCode/memberId, so it stays service-only like every other
    // index above) and its own per-UID/per-IP throttle counters.
    match /createRoomReceipts/{requestId} { allow read, write: if false; }
    match /createRoomThrottle/{document=**} { allow read, write: if false; }
    // Board task A06: recoverSeat's own per-room-code+IP / per-IP throttle counters.
    match /recoveryThrottle/{document=**} { allow read, write: if false; }
  }
}
