+async function pressKey(gm, name, { shift = false } = {}) {
+  const vk = { Tab: 9, Escape: 27 }[name];
+  const base = { key: name, code: name, windowsVirtualKeyCode: vk, nativeVirtualKeyCode: vk, modifiers: shift ? 8 : 0 };
+  await gm.cdp.send("Input.dispatchKeyEvent", { type: "keyDown", ...base }, gm.sessionId);
+  await gm.cdp.send("Input.dispatchKeyEvent", { type: "keyUp", ...base }, gm.sessionId);
+  await sleep(90);
+}
