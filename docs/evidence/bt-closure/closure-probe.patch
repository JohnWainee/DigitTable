+async function sheetInvariants(gm, record, prefix, vp) {
+  const frame = { left: 0, top: 0, right: vp.width, bottom: vp.height };
+  const geo = await ev(gm, MODAL_GEOMETRY);
+  record.checks[`${prefix}dialogInsideViewport`] = within(geo.dialog, frame);
+  record.checks[`${prefix}noPageOverflow`] = geo.pageOverflowPx <= 1;
+  record.checks[`${prefix}rootLocked`] = geo.rootLocked;
+  record.checks[`${prefix}backgroundInert`] = geo.inertSiblings;
+  record.checks[`${prefix}focusInsideDialog`] = geo.activeIsInside;
+  await scrollScrollerToEnd(gm);
+  const region = await ev(gm, BT_REGION);
+  const end = await ev(gm, MODAL_GEOMETRY);
+  record.checks[`${prefix}reasonFullyVisibleAtEnd`] =
+    end.reason.top >= region.top - 1 && end.reason.bottom <= region.bottom + 1;
+  record.checks[`${prefix}actionsUsable`] = await actionsUsable(gm, frame);
+  await ev(
+    gm,
+    `(() => { const sc = document.querySelector(".sheet[data-tight]") ?? document.querySelector(".sheet-body"); sc.scrollTop = 0; })()`,
+  );
+  return { geo, region };
