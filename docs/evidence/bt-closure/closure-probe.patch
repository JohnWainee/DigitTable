+async function probeBrowserChrome(gm) {
+  // Dynamic browser chrome: the visible height changes by the height of the URL bar / toolbars while a
+  // sheet is open. Repeated collapse/expand must land on identical geometry and keep a bottom sheet
+  // flush with the bottom of what is visible.
+  for (const [vp, deltas] of [
+    [byName["phone"], [110, 56]],
+    [byName["phone-small"], [98, 56]],
+    [{ name: "phone-360x740", width: 360, height: 740, mobile: true }, [120, 56]],
+    [byName["tablet"], [90, 50]],
+  ]) {
+    await probe(`chrome-${vp.width}x${vp.height}`, vp, async (record) => {
+      await openCorrection(gm);
+      const base = await ev(gm, MODAL_GEOMETRY);
+      const baseTight = await ev(gm, `document.querySelector(".sheet").hasAttribute("data-tight")`);
+      for (let round = 0; round < 3; round += 1) {
+        for (const d of deltas) {
+          const shrunk = { ...vp, height: vp.height - d };
+          await applyViewport(gm, shrunk);
+          await sleep(220);
+          const geo = await ev(gm, MODAL_GEOMETRY);
+          const frame = { left: 0, top: 0, right: shrunk.width, bottom: shrunk.height };
+          record.checks[`r${round}-${d}:dialogInside`] = within(geo.dialog, frame);
+          if (vp.width < 641) {
+            record.checks[`r${round}-${d}:bottomSheetFlushWithVisibleBottom`] = Math.abs(geo.dialog.bottom - shrunk.height) <= 1;
+          }
+          record.checks[`r${round}-${d}:actionsInside`] = within(geo.apply, frame) || (await actionsUsable(gm, frame));
+        }
+        await applyViewport(gm, vp);
+        await sleep(300);
+      }
+      const end = await ev(gm, MODAL_GEOMETRY);
+      const endTight = await ev(gm, `document.querySelector(".sheet").hasAttribute("data-tight")`);
+      record.checks["afterCollapseExpandLoops:sameGeometry"] =
+        Math.abs(end.dialog.top - base.dialog.top) <= 1 &&
+        Math.abs(end.dialog.height - base.dialog.height) <= 1 &&
+        endTight === baseTight;
+      record.screenshot = await screenshot(gm, `bt-chrome-${vp.width}x${vp.height}.jpg`, { fullPage: false });
+    });
+  }
+}
