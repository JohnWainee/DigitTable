+const BT_ACTIVE = `(() => {
+  const a = document.activeElement;
+  const d = document.querySelector('[role="dialog"]');
+  const r = a.getBoundingClientRect();
+  const cs = getComputedStyle(a);
+  const sheet = d?.getBoundingClientRect();
+  const footer = d?.querySelector(".sheet-footer");
+  const inFooter = Boolean(footer && footer.contains(a));
+  const ring = parseFloat(cs.outlineWidth) + parseFloat(cs.outlineOffset);
+  return {
+    tag: a.tagName.toLowerCase(),
+    label: (a.getAttribute("aria-label") || a.textContent || a.id || "").trim().slice(0, 34),
+    inside: Boolean(d && d.contains(a)),
+    inFooter,
+    rect: { top: r.top, bottom: r.bottom, left: r.left, right: r.right },
+    ring: cs.outlineStyle === "none" ? 0 : ring,
+    outline: cs.outlineStyle + " " + cs.outlineWidth + " " + cs.outlineColor,
+    footerRect: footer ? (({ top, bottom, left, right }) => ({ top, bottom, left, right }))(footer.getBoundingClientRect()) : null,
+    sheetRect: sheet ? { left: sheet.left, right: sheet.right, top: sheet.top, bottom: sheet.bottom } : null,
+  };
+})()`;
