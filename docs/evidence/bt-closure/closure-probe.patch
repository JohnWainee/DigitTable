+async function probe(name, viewport, body) {
+  console.log("probe start", name);
+  const record = { probe: name, viewport: viewport?.name, size: viewport ? `${viewport.width}x${viewport.height}` : null, checks: {}, notes: [] };
+  try {
+    if (viewport) await applyViewport(gm_(), viewport);
+    await body(record);
+  } catch (error) {
+    fail(`probe-${name}`, `probe threw: ${error.message}`);
+    record.notes.push(`threw: ${error.message}`);
+  }
+  if (Object.keys(record.checks).length === 0) fail(`probe-${name}`, "no checks were executed");
+  for (const [k, v] of Object.entries(record.checks)) if (!v) fail(`probe-${name}`, `${k} failed`);
+  report.probe.push(record);
+  const gm = gm_();
+  for (const [method, params] of [
+    ["Emulation.setEmulatedMedia", { features: [] }],
+    ["Emulation.setPageScaleFactor", { pageScaleFactor: 1 }],
+  ]) {
+    try {
+      await gm.cdp.send(method, params, gm.sessionId);
+    } catch {
+      /* not applied */
+    }
+  }
+  await ev(gm, `(() => { document.documentElement.style.fontSize = ""; document.getElementById("bt-spacing")?.remove(); })()`);
+  if (await ev(gm, `Boolean(document.querySelector('[role="dialog"]'))`)) await closeCorrection(gm);
