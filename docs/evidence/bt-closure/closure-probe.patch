+async function probeKeyboardWalk(gm) {
+  const cases = [
+    [byName["phone"], 16, false],
+    [byName["phone-small"], 32, true],
+    [byName["phone-landscape"], 16, false],
+    [byName["tablet"], 16, false],
+    [byName["desktop"], 16, false],
+  ];
+  for (const [vp, px, withKeyboardShrink] of cases) {
+    await probe(`keys-${vp.name}${px === 32 ? "@200" : ""}${withKeyboardShrink ? "+kb" : ""}`, vp, async (record) => {
+      await ev(gm, `document.documentElement.style.fontSize = "${px}px"`);
+      await openCorrection(gm);
+      let frame = { left: 0, top: 0, right: vp.width, bottom: vp.height };
+      if (withKeyboardShrink) {
+        await ev(gm, `document.querySelector("#correction-reason").focus()`);
+        const shrunk = { ...vp, height: Math.round(vp.height * 0.55) };
+        console.log("  shrink", JSON.stringify(shrunk));
+        await applyViewport(gm, shrunk);
+        await sleep(500);
+        frame = { left: 0, top: 0, right: shrunk.width, bottom: shrunk.height };
+        await ev(gm, `document.querySelector(".sheet-header h2").focus()`);
+      }
+      const total = await ev(
+        gm,
+        `[...document.querySelectorAll('[role="dialog"] button:not([disabled]), [role="dialog"] input:not([disabled]), [role="dialog"] textarea, [role="dialog"] select')].length`,
+      );
+      const stops = [];
+      let clippedRing = 0;
+      let coveredByFooter = 0;
+      let escaped = 0;
+      for (let i = 0; i < total + 2; i += 1) {
+        await pressKey(gm, "Tab");
+        const a = await ev(gm, BT_ACTIVE);
+        stops.push(a.label);
+        if (!a.inside) escaped += 1;
+        const region = await ev(gm, BT_REGION);
+        const inner = a.sheetRect ? { left: a.sheetRect.left + 2, right: a.sheetRect.right - 2 } : null;
+        if (inner && (a.rect.left - a.ring < inner.left - 0.5 || a.rect.right + a.ring > inner.right + 0.5)) clippedRing += 1;
+        if (a.ring > 0 && !a.inFooter && (a.rect.top < region.top - 0.5 || a.rect.bottom > region.bottom + 0.5)) coveredByFooter += 1;
+        if (a.inFooter && a.footerRect) {
+          const vis = Math.min(a.rect.bottom, a.footerRect.bottom, frame.bottom) - Math.max(a.rect.top, a.footerRect.top, frame.top);
+          if (vis < Math.min(a.rect.bottom - a.rect.top, 44) - 0.5) coveredByFooter += 1;
+        }
+      }
+      record.stops = stops;
+      record.checks.focusNeverLeavesDialog = escaped === 0;
+      record.checks.tabCycleWraps = stops.length >= 2 && stops[total] === stops[0];
+      record.checks.focusRingNeverClippedHorizontally = clippedRing === 0;
+      record.checks.focusedControlNeverHiddenBehindPinnedRow = coveredByFooter === 0;
+      // Shift+Tab from the first stop wraps to the last one.
+      await ev(gm, `document.querySelector('[role="dialog"] h2').focus()`);
+      await pressKey(gm, "Tab", { shift: true });
+      const back = await ev(gm, BT_ACTIVE);
+      record.checks.shiftTabFromHeadingWrapsIntoDialog = back.inside;
+      record.screenshot = await screenshot(gm, `bt-keys-${vp.name}${px === 32 ? "-200" : ""}.jpg`, { fullPage: false });
+      // Escape closes and focus returns to the Correct button.
+      // A synthesized real Escape stalls this Mac's Chrome main thread for minutes (NSMenu key-equivalent
+      // validation in SCNetworkSetCopyAll), so it is sent for the 375px phone case and dispatched as a DOM
+      // KeyboardEvent (the sheet listens on document) for the rest; both are recorded in the report.
+      record.escapeVia = ["phone"].includes(vp.name) ? "cdp-real-key" : "dom-keyboardevent";
+      console.log("  sending Escape via", record.escapeVia);
+      if (record.escapeVia === "cdp-real-key") await pressKey(gm, "Escape");
+      else await ev(gm, `document.activeElement.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }))`);
+      console.log("  Escape sent");
+      await sleep(250);
+      const closed = await ev(
+        gm,
+        `({ open: Boolean(document.querySelector('[role="dialog"]')), focus: document.activeElement?.textContent?.trim(), anyInert: [...document.body.children].some(c => c.hasAttribute("inert")), locked: document.documentElement.classList.contains("sheet-open") })`,
+      );
+      console.log("  closed state", JSON.stringify(closed));
+      record.checks.escapeClosesSheet = closed.open === false;
+      record.checks.focusReturnsToCorrectButton = closed.focus === "Correct";
+      record.checks.noInertOrScrollLockLeftBehind = !closed.anyInert && !closed.locked;
+    });
+  }
+}
