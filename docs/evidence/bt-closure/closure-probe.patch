+const SPACING_CSS = `* { line-height: 1.5 !important; letter-spacing: 0.12em !important; word-spacing: 0.16em !important; } p { margin-bottom: 2em !important; }`;
+const CLIPPED_TEXT = `(() => {
+  const out = [];
+  for (const e of document.querySelectorAll("body *")) {
+    if (e.closest("svg") || e.closest("[inert]") && !e.closest('[role="dialog"]')) continue;
+    const cs = getComputedStyle(e);
+    if (cs.display === "none" || cs.visibility === "hidden") continue;
+    const clipsY = ["hidden", "clip"].includes(cs.overflowY);
+    const clipsX = ["hidden", "clip"].includes(cs.overflowX);
+    if (e.tagName === "SELECT") continue; // ellipsised on purpose; the OS owns the popup
+    if (clipsY && e.scrollHeight > e.clientHeight + 1 && e.clientHeight > 0 && (e.textContent || "").trim()) out.push("Y " + e.tagName.toLowerCase() + "." + String(e.className).split(" ")[0] + " " + e.scrollHeight + ">" + e.clientHeight);
+    if (clipsX && e.scrollWidth > e.clientWidth + 1 && (e.textContent || "").trim()) out.push("X " + e.tagName.toLowerCase() + "." + String(e.className).split(" ")[0] + " " + e.scrollWidth + ">" + e.clientWidth);
+  }
+  return out.slice(0, 12);
+})()`;
